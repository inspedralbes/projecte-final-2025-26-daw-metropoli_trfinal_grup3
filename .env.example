# ── 1. MongoDB Atlas 
# Consigue tu cadena de conexión en MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/

# ── 2. API de Gemini
# Consigue tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── 3. Base de Datos MySQL (Estructura Relacional)
DB_HOST=db
DB_USER=root
DB_PASSWORD=password
DB_NAME=metropoli
DB_PORT=3306

# ── 4. Configuración del Contenedor MySQL (Docker)
# Estos deben coincidir con DB_PASSWORD y DB_NAME de arriba
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=metropoli

# ── 5. Google OAuth 
# Consigue estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="tu_google_client_id_del_backend"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
VITE_GOOGLE_CLIENT_ID="tu_google_client_id_del_frontend"

# ── 6. Email SMTP (Envío de correos)
# Ejemplo para Gmail (necesitas "Contraseña de aplicación")
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="tu_correo@gmail.com"
EMAIL_PASS="tu_contraseña_de_aplicacion"

# ── 7. Frontend Config 
VITE_API_URL=http://localhost:3000
# VITE_API_URL=https://tu-dominio-produccion.com
VITE_GIPHY_API_KEY=tu_giphy_api_key_aqui
